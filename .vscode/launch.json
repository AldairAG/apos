{
  "version": "0.2.0",
  "configurations": [
    {
      // 🚀 Backend Spring Boot
      "type": "java",
      "name": "Spring Boot-Application<apos>",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend", 
      "mainClass": "com.api.apos.AposApplication",
      "projectName": "apos",
      "args": "",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // 📱 Expo Web
      "name": "Debug Expo Web",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
        "webpack:///./*": "${workspaceFolder}/frontend/*",
        "webpack:///*": "*"
      }
    }
  ]
}